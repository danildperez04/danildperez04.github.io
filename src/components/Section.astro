---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}
const { id, eyebrow, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="container-page pt-16">
  <span class="eyebrow">{eyebrow}</span>
  <h2 id={`${id}-title`} class="section-title">
    {title}
  </h2>
  <slot />
</section>
