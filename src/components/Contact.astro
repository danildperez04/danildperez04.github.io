---
import Section from './Section.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<Section id="contact" eyebrow={t('contact.eyebrow')} title={t('contact.title')}>
  <div class="grid gap-4 rounded-md bg-accent-soft p-6 sm:p-8">
    <p class="m-0 max-w-lg text-muted">{t('contact.text')}</p>
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={`mailto:${profile.email}`}
        class="rounded-sm border border-border bg-surface px-3 py-2 font-mono text-[0.9rem] break-all text-fg no-underline hover:border-accent"
        data-email
      >
        {profile.email}
      </a>
      <button
        type="button"
        class="btn btn-primary cursor-pointer"
        data-copy={profile.email}
        data-copied-label={t('contact.copied')}
      >
        {t('contact.copy')}
      </button>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="btn btn-secondary" href={profile.linkedin} target="_blank" rel="noopener">
        LinkedIn ↗
      </a>
      <a class="btn btn-secondary" href={profile.github} target="_blank" rel="noopener">
        GitHub ↗
      </a>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const original = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = button.dataset.copiedLabel ?? original;
        setTimeout(() => (button.textContent = original), 1500);
      } catch {
        // Sin portapapeles: se selecciona el correo para copiarlo a mano.
        const email = document.querySelector('[data-email]');
        if (email) getSelection()?.selectAllChildren(email);
      }
    });
  });
</script>
