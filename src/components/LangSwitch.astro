---
import { homeUrl, otherLang } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  label: string;
}
const { lang, label } = Astro.props;
const target = otherLang(lang);
---

<a
  class="icon-btn"
  href={homeUrl(target)}
  hreflang={target}
  lang={target}
  aria-label={label}
  title={label}
  data-lang-switch
>
  {target.toUpperCase()}
</a>

<script>
  // Conserva la sección actual (#projects, #contact…) al cambiar de idioma.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
    link.addEventListener('click', () => {
      if (location.hash) link.href = link.href.split('#')[0] + location.hash;
    });
  });
</script>
