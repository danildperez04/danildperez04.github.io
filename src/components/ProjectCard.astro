---
interface Props {
  title: string;
  summary: string;
  stack: string[];
  href?: string;
}
const { title, summary, stack, href } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag
  href={href}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener' : undefined}
  class="group grid grid-rows-[auto_1fr_auto] gap-3 rounded-md border border-border bg-surface p-6 text-inherit no-underline transition hover:-translate-y-0.5 hover:border-accent hover:shadow-card"
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-[1.05rem] font-semibold tracking-tight">{title}</h3>
    {href && (
      <span
        class="text-muted transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
        aria-hidden="true"
      >
        ↗
      </span>
    )}
  </div>
  <p class="m-0 text-[0.93rem] text-muted">{summary}</p>
  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
    {stack.map((item) => (
      <li class="tag-outline">{item}</li>
    ))}
  </ul>
</Tag>
